---
import '../styles/global.css';
import { getLangFromUrl, t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import ControlBar from '../components/ControlBar.astro';

type ViewType = 'landing' | 'home' | 'list' | 'poem';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  lang?: Lang;
  /** Path after /{lang}/ — used to build canonical and hreflang URLs. E.g. '' for landing, 'demo/' for collection home. */
  langPath?: string;
  /** Current view — controls which ControlBar sections render. */
  view?: ViewType;
}

const {
  title = 'Stanza',
  description = '',
  bodyClass = '',
  lang: langProp,
  langPath,
  view = 'landing',
} = Astro.props;

const lang = langProp ?? getLangFromUrl(Astro.url);
const tr = t(lang);

const siteBase = Astro.site?.href ?? 'https://stanza.pages.dev/';
const altLang: Lang = lang === 'en' ? 'el' : 'en';
const canonicalUrl = langPath !== undefined ? new URL(`${lang}/${langPath}`, siteBase).href : null;
const altUrl = langPath !== undefined
  ? new URL(`${altLang}/${langPath}`, siteBase).href
  : `/${altLang}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && altUrl && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={altLang} href={altUrl} />
        <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalUrl : altUrl} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&subset=greek&display=swap"
      rel="stylesheet"
    />
    <!-- Pre-paint theme: must run before first paint to avoid flash -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', saved);
      })();
    </script>
  </head>

  <body class={bodyClass} data-lang={lang}>
    <!-- Fixed theme toggle — top right -->
    <button
      class="theme-toggle-fixed"
      id="theme-toggle"
      title={tr('theme_dark')}
      aria-label={tr('theme_dark')}
    >
      <!-- moon icon (shown in light mode) -->
      <svg
        class="icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <!-- sun icon (shown in dark mode) -->
      <svg
        class="icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>

    <div class="container">
      <!-- Breadcrumbs slot — individual pages inject their own -->
      <slot name="breadcrumbs" />

      <main>
        <slot />
      </main>

      <!-- Public control bar -->
      <ControlBar lang={lang} altHref={altUrl} view={view} />

      <footer>
        <slot name="footer" />
      </footer>
    </div>

    <script>
      // Theme toggle
      function toggleTheme() {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateThemeBtn(next);
      }

      function updateThemeBtn(theme: string) {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const darkLabel = btn.dataset.labelDark ?? 'Dark';
        const lightLabel = btn.dataset.labelLight ?? 'Light';
        btn.title = theme === 'dark' ? lightLabel : darkLabel;
        btn.setAttribute('aria-label', theme === 'dark' ? lightLabel : darkLabel);
      }

      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);

      // Reveal-on-scroll observer (one-shot)
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 },
      );

      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
        updateThemeBtn(document.documentElement.getAttribute('data-theme') ?? 'light');
      });

      // Close dropdowns when clicking outside
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.dropdown')) {
          document.querySelectorAll('.dropdown').forEach((d) => d.classList.remove('active'));
        }
      });

      // Dropdown toggle helper (used by ControlBar)
      (window as any).toggleDropdown = function (idOrEvent: string | Event, id?: string) {
        let targetId: string;
        if (typeof idOrEvent === 'string') {
          targetId = idOrEvent;
        } else {
          idOrEvent.preventDefault();
          (idOrEvent as Event).stopPropagation();
          targetId = id!;
        }
        document.querySelectorAll('.dropdown').forEach((d) => {
          if (d.id !== targetId) d.classList.remove('active');
        });
        document.getElementById(targetId)?.classList.toggle('active');
      };
    </script>
  </body>
</html>
