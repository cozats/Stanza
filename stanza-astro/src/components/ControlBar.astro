---
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altHref: string;
  view: 'landing' | 'home' | 'list' | 'poem';
}

const { lang, altHref, view } = Astro.props;
const tr = t(lang);

const altLangLabel = lang === 'en' ? 'Ελληνικά' : 'English';
const curLangLabel = lang === 'en' ? 'English' : 'Ελληνικά';
const showSort = view === 'list';
const showAlign = view === 'list' || view === 'poem';
---

<div class="admin-toolbar">
  <!-- Language switcher -->
  <div class="dropdown" id="lang-dropdown">
    <button type="button" onclick="toggleDropdown('lang-dropdown')">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path
          d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
        ></path>
      </svg>
      <span>{curLangLabel}</span>
    </button>
    <div class="dropdown-content">
      <a href={lang === 'en' ? '#' : altHref} class={lang === 'en' ? 'active' : ''}
        >English</a
      >
      <a href={lang === 'el' ? '#' : altHref} class={lang === 'el' ? 'active' : ''}
        >Ελληνικά</a
      >
    </div>
  </div>

  <!-- Sort (list view only) -->
  {
    showSort && (
      <div class="dropdown" id="sort-dropdown">
        <a href="#" onclick="toggleDropdown(event, 'sort-dropdown')">
          <span class="icon-wrapper">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          </span>
          <span>{tr('sort')}</span>
          <span class="sort-value">: {tr('sort_alpha')}</span>
        </a>
        <div class="dropdown-content">
          <button onclick="setSort('alpha')" class="active">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            {tr('sort_alpha')}
          </button>
          <button onclick="setSort('latest')">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M11 5h10" />
              <path d="M11 9h7" />
              <path d="M11 13h4" />
              <path d="m3 17 3 3 3-3" />
              <path d="M6 18V4" />
            </svg>
            {tr('sort_latest')}
          </button>
        </div>
      </div>
    )
  }

  <!-- Alignment (list + poem) -->
  {
    showAlign && (
      <div class="dropdown" id="align-dropdown">
        <a href="#" onclick="toggleDropdown(event, 'align-dropdown')">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="17" y1="10" x2="3" y2="10" />
            <line x1="21" y1="6" x2="3" y2="6" />
            <line x1="21" y1="14" x2="3" y2="14" />
            <line x1="17" y1="18" x2="3" y2="18" />
          </svg>
          <span>{tr('align')}</span>
        </a>
        <div class="dropdown-content">
          <button onclick="setAlignment('left')">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="17" y1="10" x2="3" y2="10" />
              <line x1="21" y1="6" x2="3" y2="6" />
              <line x1="21" y1="14" x2="3" y2="14" />
              <line x1="17" y1="18" x2="3" y2="18" />
            </svg>
            {tr('align_left')}
          </button>
          <button onclick="setAlignment('center')" class="active">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="10" x2="6" y2="10" />
              <line x1="21" y1="6" x2="3" y2="6" />
              <line x1="21" y1="14" x2="3" y2="14" />
              <line x1="18" y1="18" x2="6" y2="18" />
            </svg>
            {tr('align_center')}
          </button>
          <button onclick="setAlignment('right')">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="21" y1="10" x2="7" y2="10" />
              <line x1="21" y1="6" x2="3" y2="6" />
              <line x1="21" y1="14" x2="3" y2="14" />
              <line x1="21" y1="18" x2="7" y2="18" />
            </svg>
            {tr('align_right')}
          </button>
        </div>
      </div>
    )
  }

  <!-- Edit controls (view-specific, hidden until authenticated) -->
  {view === 'landing' && (
    <button class="edit-control" id="edit-profile-btn" title="Edit profile" aria-label="Edit profile">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
      </svg>
      <span>Edit Profile</span>
    </button>
  )}
  {view === 'home' && (
    <>
      <button class="edit-control" id="edit-collection-btn" title="Edit collection" aria-label="Edit collection">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        <span>Edit</span>
      </button>
      <button class="edit-control danger" id="delete-collection-btn" title="Delete collection" aria-label="Delete collection">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
          <path d="M10 11v6"/><path d="M14 11v6"/>
          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
        </svg>
        <span>Delete</span>
      </button>
    </>
  )}
  {view === 'list' && (
    <button class="edit-control" id="new-poem-btn" title="New poem" aria-label="New poem">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      <span>New Poem</span>
    </button>
  )}
  {view === 'poem' && (
    <>
      <button class="edit-control" id="edit-poem-btn" title="Edit poem" aria-label="Edit poem">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        <span>Edit</span>
      </button>
      <button class="edit-control danger" id="delete-poem-btn" title="Delete poem" aria-label="Delete poem">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
          <path d="M10 11v6"/><path d="M14 11v6"/>
          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
        </svg>
        <span>Delete</span>
      </button>
    </>
  )}

  <!-- Lock button (always visible) -->
  <button class="admin-lock-btn" id="admin-lock-btn" title="Sign in to edit" aria-label="Sign in to edit">
    <!-- Closed lock (logged out) -->
    <svg class="icon-lock-closed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </svg>
    <!-- Open lock (logged in) -->
    <svg class="icon-lock-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 9.9-1"/>
    </svg>
  </button>
</div>

<script>
  import '../scripts/controls';
  import '../scripts/editor';
</script>
