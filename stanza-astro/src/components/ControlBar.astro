---
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altHref: string;
  view: 'landing' | 'home' | 'list' | 'poem';
}

const { lang, altHref, view } = Astro.props;
const tr = t(lang);

const altLangLabel = lang === 'en' ? 'Ελληνικά' : 'English';
const curLangLabel = lang === 'en' ? 'English' : 'Ελληνικά';
const showSort = view === 'list';
const showAlign = view === 'list' || view === 'poem';
---

<div class="admin-toolbar">
  <!-- Language switcher -->
  <div class="dropdown" id="lang-dropdown">
    <button type="button" onclick="toggleDropdown('lang-dropdown')">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path
          d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
        ></path>
      </svg>
      <span>{curLangLabel}</span>
    </button>
    <div class="dropdown-content">
      <a href={lang === 'en' ? '#' : altHref} class={lang === 'en' ? 'active' : ''}
        >English</a
      >
      <a href={lang === 'el' ? '#' : altHref} class={lang === 'el' ? 'active' : ''}
        >Ελληνικά</a
      >
    </div>
  </div>

  <!-- Sort (list view only) -->
  {
    showSort && (
      <div class="dropdown" id="sort-dropdown">
        <a href="#" onclick="toggleDropdown(event, 'sort-dropdown')">
          <span class="icon-wrapper">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          </span>
          <span>{tr('sort')}</span>
          <span class="sort-value">: {tr('sort_alpha')}</span>
        </a>
        <div class="dropdown-content">
          <button onclick="setSort('alpha')" class="active">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            {tr('sort_alpha')}
          </button>
          <button onclick="setSort('latest')">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M11 5h10" />
              <path d="M11 9h7" />
              <path d="M11 13h4" />
              <path d="m3 17 3 3 3-3" />
              <path d="M6 18V4" />
            </svg>
            {tr('sort_latest')}
          </button>
        </div>
      </div>
    )
  }

  <!-- Alignment (list + poem) -->
  {
    showAlign && (
      <div class="dropdown" id="align-dropdown">
        <a href="#" onclick="toggleDropdown(event, 'align-dropdown')">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="17" y1="10" x2="3" y2="10" />
            <line x1="21" y1="6" x2="3" y2="6" />
            <line x1="21" y1="14" x2="3" y2="14" />
            <line x1="17" y1="18" x2="3" y2="18" />
          </svg>
          <span>{tr('align')}</span>
        </a>
        <div class="dropdown-content">
          <button onclick="setAlignment('left')">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="17" y1="10" x2="3" y2="10" />
              <line x1="21" y1="6" x2="3" y2="6" />
              <line x1="21" y1="14" x2="3" y2="14" />
              <line x1="17" y1="18" x2="3" y2="18" />
            </svg>
            {tr('align_left')}
          </button>
          <button onclick="setAlignment('center')" class="active">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="10" x2="6" y2="10" />
              <line x1="21" y1="6" x2="3" y2="6" />
              <line x1="21" y1="14" x2="3" y2="14" />
              <line x1="18" y1="18" x2="6" y2="18" />
            </svg>
            {tr('align_center')}
          </button>
          <button onclick="setAlignment('right')">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="21" y1="10" x2="7" y2="10" />
              <line x1="21" y1="6" x2="3" y2="6" />
              <line x1="21" y1="14" x2="3" y2="14" />
              <line x1="21" y1="18" x2="7" y2="18" />
            </svg>
            {tr('align_right')}
          </button>
        </div>
      </div>
    )
  }
</div>

<script>
  import '../scripts/controls';
</script>
