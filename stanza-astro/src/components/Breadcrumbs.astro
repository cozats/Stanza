---
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  view: 'home' | 'list' | 'poem';
  collection?: { id: string; title: string };
  poemTitle?: string;
}

const { lang, view, collection, poemTitle } = Astro.props;
const tr = t(lang);
---

<div class="breadcrumbs">
  <a href={`/${lang}/`}>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h3.5z"></path>
      <line x1="16" y1="8" x2="2" y2="22"></line>
      <path d="M11 11l2.5 2.5"></path>
      <path d="M13 9l2.5 2.5"></path>
      <path d="M15 7l2.5 2.5"></path>
    </svg>
    {tr('profile')}
  </a>
  <span class="breadcrumb-separator">›</span>

  {
    view === 'home' && (
      <span class="breadcrumb-current">{collection?.title}</span>
    )
  }

  {
    view === 'list' && (
      <>
        <a href={`/${lang}/${collection?.id}/`}>{collection?.title}</a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-current">{tr('contents')}</span>
      </>
    )
  }

  {
    view === 'poem' && (
      <>
        <a href={`/${lang}/${collection?.id}/`}>{collection?.title}</a>
        <span class="breadcrumb-separator">›</span>
        <a href={`/${lang}/${collection?.id}/index/`}>{tr('contents')}</a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-current">{poemTitle}</span>
      </>
    )
  }
</div>

<script>
  // Scroll breadcrumbs to the right end on mobile so current item is visible
  document.addEventListener('DOMContentLoaded', () => {
    const bc = document.querySelector('.breadcrumbs') as HTMLElement | null;
    if (bc) {
      setTimeout(() => {
        bc.scrollLeft = bc.scrollWidth;
      }, 50);
    }
  });
</script>
