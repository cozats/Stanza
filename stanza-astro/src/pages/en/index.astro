---
import Base from '../../layouts/Base.astro';
---

<Base title="Stanza" lang="en" bodyClass="view-landing">
  <div class="author-section reveal-on-scroll">
    <div class="author-photo-placeholder" aria-hidden="true">S</div>
    <h1 class="author-name">Stanza</h1>
    <p class="author-bio">A poetry platform.</p>
  </div>

  <h2 class="collections-title">Collections</h2>
  <div class="collections-grid">
    <p style="grid-column: 1/-1; text-align: center; opacity: 0.6;">
      No published collections yet.
    </p>
  </div>

  <Fragment slot="footer">
    © {new Date().getFullYear()} Stanza •
    <a href="https://cozats.github.io/Stanza/" target="_blank">About Stanza</a>
  </Fragment>
</Base>
